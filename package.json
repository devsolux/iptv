{
  "name": "iptv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "IPTV \u2014 an offline-first, remote-friendly Ionic and Tauri application",
  "author": "Baris Aydin",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "dev:android": "tauri android dev",
    "build": "tauri build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "android:init": "tauri android init && node scripts/android-configure.mjs",
    "build:android": "tauri android build --target armv7 aarch64",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "doctor": "node scripts/project.mjs doctor",
    "clean": "node scripts/project.mjs clean",
    "verify:source": "node scripts/project.mjs verify",
    "verify:release": "node scripts/project.mjs release",
    "bootstrap": "node scripts/bootstrap.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ionic/react": "9.0.7",
    "@tanstack/react-virtual": "3.14.17",
    "@tauri-apps/api": "2.12.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zustand": "5.0.15",
    "hls.js": "1.7.3",
    "dashjs": "5.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
